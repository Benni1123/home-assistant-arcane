        "config_entry_id": {"name": "Arcane environment"},
        "containers": {"name": "Containers"},
        "container_age_hours": {"name": "Container age in hours", "description": "Required for Older than. Uses creation time, not time since stopping."},
        "images": {"name": "Images"},
        "image_age_hours": {"name": "Image age in hours", "description": "Required for Older than. Only unused images."},
        "networks": {"name": "Networks"},
        "network_age_hours": {"name": "Network age in hours", "description": "Required for Older than. Only unused networks."},
        "volumes": {"name": "Volumes", "description": "DANGER: even anonymous or unused volumes may hold important data."},
        "build_cache": {"name": "Build cache"},
        "build_cache_age_hours": {"name": "Build cache age in hours", "description": "Required for Older than. Time since last use."},
        "confirm": {"name": "I confirm permanent deletion", "description": "This cleanup cannot be undone."},
        "confirm_volumes": {"name": "I also confirm deletion of volume data", "description": "Required for any volume cleanup. Back up important data first."}
      }
    }
  },
