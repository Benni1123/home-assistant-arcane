  "services": {
    "prune": {
      "name": "Clean up Docker resources",
      "description": "Permanently delete selected unused resources in one Arcane 3 environment. Nothing is selected by default. Removing stopped containers can make their images and volumes eligible too. Back up important data. Requires admin access. Submission is not completion; check the cleanup-status sensor or Arcane activity.",
